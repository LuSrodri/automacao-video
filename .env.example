# ---- Chaves de API (obrigatórias) ----
# Chave da OpenAI (https://platform.openai.com/api-keys) — sumarização das
# trends, roteiro e descrição das mídias (visão)
OPENAI_API_KEY=

# Chave da ElevenLabs (https://elevenlabs.io/app/settings/api-keys) — narração
ELEVENLABS_API_KEY=

# X API oficial (pay-per-use, ~US$ 0,005 por post lido). Consumer Key + Secret
# do app em https://developer.x.com — usados para ler a lista de onde sai a
# pauta e baixar os clipes de vídeo dos posts originais da trend.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=

# ---- Fontes ----
# Id da LISTA do X de onde sai a pauta (/2/lists/{id}/tweets): uma chamada
# paginada, cronológica, com os posts de todos os membros. Pôr ou tirar alguém
# da lista muda a coleta da próxima execução, sem commit nem deploy.
#
# VIROU O FALLBACK em 2026-08-28: na frente dela estão as CURTIDAS do usuário
# (X_CURTIDOS, logo abaixo). Continua OBRIGATÓRIA — é ela que sustenta o dia em
# que não houve curtida com clipe, e falha de leitura DELA aborta a execução.
#
# O caminho antigo — ler as CONTAS SEGUIDAS por busca com `from:` em lotes,
# mais as timelines — foi removido em 2026-08-22. Ele existia como fallback e
# escondia defeito: com o token do X vencido a lista voltava 401 e o vídeo saía
# assim mesmo, montado pela ordenação por RELEVÂNCIA que a lista existe para
# eliminar.
X_LIST_ID=

# ---- Curtidas do usuário: a FONTE PRIMÁRIA da pauta (2026-08-28) ----
# Lê `/2/users/:id/liked_tweets`: os posts que o dono da conta curtiu. Curtir
# um post no X passou a ser a forma mais barata de mexer na pauta do canal — o
# mesmo orçamento de leitura compra material escolhido a mão em vez de timeline
# bruta. A lista acima fica atrás, como fallback.
#
# EXIGE O ESCOPO `like.read` NO TOKEN DO X, que a lista privada não pedia.
# Token autorizado antes de 2026-08-28 NÃO o tem: a leitura volta 403, o
# pipeline avisa no log e usa a lista. Para ativar de verdade, reautorize no
# navegador pedindo `like.read` junto dos escopos atuais e regrave
# X_OAUTH_REFRESH_TOKEN.
#
# 1 liga (padrão), 0 desliga e volta ao comportamento anterior (só a lista).
X_CURTIDOS=1
# Janela da coleta de curtidas, em DIAS. Ela é aplicada sobre a data do POST: a
# X API não devolve QUANDO a curtida aconteceu, só a ORDEM (da curtida mais
# nova para a mais velha), então "curtido nos últimos 7 dias" é aproximado por
# "está entre as curtidas mais recentes E foi publicado nos últimos 7 dias".
X_CURTIDOS_DIAS=7
# Piso de posts APROVEITÁVEIS abaixo do qual a coleta CAI PARA A LISTA. O
# gatilho do fallback é escassez, não erro: semana sem curtir, curtida em post
# de texto e escopo ausente chegam todos como "veio pouco". Um punhado de posts
# não forma trend, e mandar o GPT tirar dez trends de três posts inventa pauta.
X_CURTIDOS_MIN=5

# ---- Token de usuário do X (lista PRIVADA) ----
# Lista privada exige contexto de USUÁRIO; pública aceita só o bearer app-only
# acima. O refresh token do X é de USO ÚNICO: cada renovação emite outro e mata
# o anterior, então quem renova é UM cron dedicado (`--renovar-x-token`), que
# grava o access token e o vencimento dele nas env vars do próprio serviço e é
# de lá que os crons de vídeo leem, em tempo de execução.
#
# Para (re)autorizar: `python main.py --auth-x`. Ele faz o PKCE, IMPRIME OS
# ESCOPOS CONCEDIDOS e grava os tokens direto no serviço do renovador no
# Render. Usa o callback http://localhost:8080/callback, que JÁ está cadastrado
# no app (o X exige correspondência exata, inclusive do caminho;
# X_OAUTH_REDIRECT_URI muda o valor, mas o novo precisa estar cadastrado lá).
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REFRESH_TOKEN=
# Preenchidas pelo cron renovador; não edite à mão.
X_OAUTH_ACCESS_TOKEN=
X_OAUTH_ACCESS_TOKEN_EXPIRA=
# API do Render e id do serviço do cron renovador — é onde o token vive.
RENDER_API_KEY=
RENDER_TOKEN_SERVICE_ID=
# Minutos de vida restante abaixo dos quais o renovador troca o access token
# (ele vale 2h). Precisa ser MAIOR que o intervalo entre execuções do cron
# renovador, senão o token pode vencer entre dois ticks: era exatamente essa
# janela morta que derrubava a leitura da lista 4x por dia até 2026-08-22, com
# o renovador antigo, que só trocava o token depois de ele morrer.
X_TOKEN_MARGEM_MIN=75

# Teto de posts lidos POR VÍDEO (a X API cobra por post lido; 50 posts ≈
# US$ 0,25). Caiu de 200 para 50 em 2026-08-24, no corte de custo pedido pelo
# usuário — é o maior item da conta do pipeline.
X_MAX_POSTS=50
# Busca ABERTA por clipes do assunto, fora das contas do canal. Só o
# --long-take usa: é ele que precisa de vários clipes do MESMO fato. As fontes
# aqui NÃO são curadas (conta desconhecida, telejornal reempacotado, material
# enganoso) e quem filtra é a auditoria de visão, que julga pertinência e não
# veracidade — por isso o orçamento é modesto. 0 desliga.
X_MAX_POSTS_BUSCA=30

# LIMITE DURO de quanto conteúdo do X entra em cada vídeo, em horas (posts mais
# recentes que isso). Desde 2026-08-24 é um TETO, não um ponto de partida: o
# fallback que reabria a janela por etapas — 8h, 12h, 24h, 48h — foi REMOVIDO,
# porque cada etapa refazia a leitura inteira e a leitura é paga por post.
#
# Case a janela com a CADÊNCIA do cron: ela existe para execuções seguidas não
# pegarem os mesmos posts. Os Shorts passaram a 3x por dia em cada canal em
# 2026-08-24 (eram 6x, de 4 em 4 horas), então três janelas de 8h cobrem o dia
# inteiro sem sobreposição. Já o --long-take roda 3x por semana e precisa de UM
# acontecimento com vários posts de vídeo nativo, então os crons longos rodam
# com 48 (dois dias, que é o intervalo entre segunda, quarta e sexta).
JANELA_HORAS=8

# Quantas trends mais faladas do X coletar para escolher a do vídeo
NUM_TRENDS=10

# ---- Modelos (opcionais, valores padrão abaixo) ----
TEXT_MODEL=gpt-5.6-luna
# NÃO HÁ MAIS GERAÇÃO DE IMAGEM. IMAGEM_MODEL e IMAGEM_QUALIDADE saíram em
# 2026-08-24 junto com as figuras do gpt-image-2 (pipeline/figuras.py), por
# custo. A única imagem paga que restava sai também: a capa é montagem em
# Pillow, e o que a OpenAI faz nela é VISÃO (escolher o recorte), não geração.

# ---- Narração (ElevenLabs) ----
ELEVENLABS_VOICE_ID=czvzJwIVS2asEKnthV40
# Voz usada quando rodar com -usa (público americano)
ELEVENLABS_VOICE_ID_USA=POPWFdpTM8Mn2ZQEagyQ
# eleven_v3 suporta audio tags ([excited], [whispers] etc.) no roteiro
ELEVENLABS_MODEL=eleven_v3

# ---- Vídeo ----
# Duração-MÁXIMA da narração em segundos; a duração final do vídeo segue o
# áudio. 25s desde 2026-08-09 (pedido do usuário; vinha de 60).
#
# Virou TETO e deixou de ser meta em 2026-08-28: sem loop, quem dimensiona o
# roteiro é o material da pauta (alvo = min(este valor, metragem / 1,15)).
#
# SEM PISO DE DURAÇÃO desde a mesma data: o piso duro de 21s do Short foi
# REMOVIDO a pedido. O Short dura o que a pauta dá — quem limita por baixo é a
# auditoria (clipe com menos de 5s de trecho útil sai), não uma regra de
# formato. No --long-take o piso continua (LONGO_MIN_S = 120s).
VIDEO_DURACAO=25
# Velocidade da narração — e, com ela, o ritmo do vídeo inteiro (cortes,
# legendas e sobreposições saem do alinhamento, que é reescalado junto).
# 1.0 = normal. O SHORT roda acelerado (ritmo é o que segura o feed); o formato
# longo roda em 1.0, porque análise em fala apressada não é acompanhável.
# O orçamento de palavras do roteiro é multiplicado por este valor: narração
# mais rápida cabe mais palavras no mesmo tempo de tela.
VIDEO_VELOCIDADE=1.25
# Resolução do vídeo. Padrão: vertical 9:16 para shorts/reels.
VIDEO_LARGURA=1080
VIDEO_ALTURA=1920

# ---- Material visual e auditoria ----
# Posts da trend consultados no lookup de mídias (≈ US$ 0,005 cada). Precisa
# ser folgado: a auditoria reprova material de telejornal e clipe fora do
# assunto, e sem pool a reprovação só teria como saída abortar o vídeo.
MAX_POSTS_MIDIA=12
# Clipes baixados ALÉM dos que entram na montagem, como folga da auditoria
POOL_EXTRA_CLIPES=3
# Fotos dos posts baixadas para as cartelas (0 desliga)
MAX_FOTOS=4
# TETO DE DURAÇÃO DO CLIPE, em segundos, SÓ NO SHORT (2026-08-28). Post cujo
# menor clipe passa disto não vira pauta, e clipe acima do teto não entra no
# pool nem gasta download.
#
# Ele é a contrapartida do FIM DO LOOP no Short: a montagem não repete mais
# clipe para cobrir a janela, então o material virou o teto do vídeo — e clipe
# de quatro minutos não é material melhor que um de 25 segundos, é um clipe do
# qual só se usaria o começo, escolhido às cegas. O mínimo aceito é 5s (limite
# técnico); o piso duro de 21s do Short foi REMOVIDO em 2026-08-28.
# O formato longo NÃO tem teto — lá o loop continua e clipe comprido é ganho.
CURTO_MAX_DUR_CLIPE=30
# Cartelas de imagem nos momentos-chave (0 desliga). Cada uma TOMA A TELA
# INTEIRA pelo deslize do carrossel, no lugar do clipe — não é um cartão
# sobreposto. Com o Short em 25 segundos, cada imagem tira ~4s de clipe da tela.
# É a ÚNICA camada de imagem que sobrou: as figuras geradas (MAX_FIGURAS) saíram
# em 2026-08-24, por custo, e com elas o "big number" na tela.
MAX_CARTELAS=1
# VETO A TEXTO NA TELA (1 liga, 0 desliga). O clipe do X entra como fundo de um
# vídeo que já tem legendas grandes queimadas e cartelas por cima —
# um clipe que também é texto empilha duas leituras concorrentes e o
# espectador não faz nenhuma. Com o veto ligado, clipe TOMADO por texto (e,
# mais ainda, por texto PARADO: slide, cartaz, print) sai da montagem, A NÃO
# SER que aquele texto seja o assunto que a narração descreve — o post citado,
# a tela do produto, o número falado. Quem mede o texto é a visão
# (densidade + se está parado); quem diz se ele é o assunto é o auditor, que
# lê a narração. Desligar aceita de volta o fundo de slide atrás das legendas.
VETO_TEXTO_DENSO=1
# VETO A CLIPE PARADO E A GENTE FALANDO (1 liga, 0 desliga), 2026-08-09. Dois
# casos saem da montagem: o clipe ESTÁTICO (o mesmo quadro do começo ao fim —
# foto com áudio, slide, tela congelada) e o clipe de PESSOA FALANDO para a
# câmera (entrevista, podcast, coletiva, depoimento, âncora). Os dois falham
# pelo mesmo motivo: o vídeo é montado sobre movimento, e um quadro que não muda
# ou um busto que só mexe a boca ocupam a tela sem mostrar o fato. É veto duro,
# sem exceção de contexto e sem exceção de formato — no formato longo ele passa
# na frente da marcação de representação visual, então telejornal só entra
# quando é VT com imagens do fato, não âncora em quadro. Vale só para os
# CLIPES: as cartelas são imagens paradas por definição e passam por fora.
VETO_CLIPE_PARADO=1

# ---- Formato longo (python main.py --long-take) ----
# Vídeo de análise em 16:9, de 120 a 150 segundos, sem legendas, cobrindo de 3
# a 5 TÓPICOS, para os dois canais (combina com -usa). Estas variáveis só valem
# nessa execução — as de cima continuam mandando no formato curto, então dá
# para ter os dois crons no Render com o mesmo .env.
# Duração-alvo da narração (obrigatoriamente entre 120 e 150). O piso de 120s é
# DURO: narração mais curta que isso aborta a execução sem publicar.
LONG_DURACAO=135
LONG_LARGURA=1920
LONG_ALTURA=1080
# Clipes de vídeo do X usados na montagem (cada mídia lida ≈ US$ 0,005)
LONG_MAX_CLIPES=8
# Posts da trend consultados para achar esses clipes (≈ US$ 0,005 cada)
LONG_MAX_POSTS_MIDIA=16
# Cartelas de imagem: FORA do formato longo desde 2026-08-25. A cartela é uma
# foto que toma o quadro no meio de uma pauta, e o desenho do formato é uma
# pauta = um vídeo, do começo ao fim dela. Deixe em 0 (o carrossel segue vivo no
# Short, em MAX_CARTELAS).
LONG_MAX_CARTELAS=0
LONG_MAX_FOTOS=0
# Velocidade da narração no formato longo: NORMAL, por decisão editorial.
LONG_VELOCIDADE=1.0
# LONG_MANCHETES foi REMOVIDA em 2026-08-25. O painel de manchete deixou de ser
# uma sobreposição opcional: ele nomeia cada uma das QUATRO PARTES em que o
# vídeo longo é montado, e desligá-lo não deixaria o vídeo sem manchete —
# deixaria o vídeo sem montagem.
# PAUSA de silêncio aberta em cada troca de pauta, em segundos. É nela que o
# vídeo é CORTADO em partes e que o painel de manchete velho sai e o novo entra,
# então ela não pode mais ser 0: aceita de 0.3 a 2.
LONG_PAUSA_PAUTA=0.7

# Janela da régua de audiência, em dias: só entram na seleção os vídeos
# PUBLICADOS nos últimos N dias — tanto os "últimos publicados" quanto os
# campeões de retenção. Antes a leitura era de todos os tempos, e o molde do
# canal acabava sendo um vídeo de meses atrás, de um ciclo já morto.
DIAS_REFERENCIA=90

# ---- YouTube (publicação automática via Data API v3) ----
# Credenciais OAuth (Google Cloud Console > Credentials > OAuth client ID,
# tipo "Desktop app"). A publicação roda sempre, independente da flag -usa.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Canal português — gerado uma vez com: python main.py --auth-youtube
YOUTUBE_REFRESH_TOKEN=
# Canal inglês (-usa) — gerado com: python main.py --auth-youtube-usa
YOUTUBE_REFRESH_TOKEN_USA=
# public | unlisted | private
YOUTUBE_PRIVACY=public
# Categoria do YouTube (28 = Science & Technology)
YOUTUBE_CATEGORY_ID=28

# ---- SEO e GEO (panorama do dia) ----
# Antes de escrever o roteiro, o pipeline pergunta à YouTube Data API que
# vídeos OUTROS canais publicaram sobre o mesmo assunto nas últimas
# JANELA_HORAS: títulos, views por hora e as TAGS que eles usaram. Esse
# panorama alimenta o título, a descrição, as tags do vídeo e o texto da capa —
# é a única leitura do pipeline sobre a disputa de FORA do canal (os últimos
# publicados e a régua de retenção só enxergam o próprio público).
#
# CUSTO: uma busca por execução. Ela NÃO gasta da cota de 10.000 unidades/dia
# do projeto (que é onde o upload consome 1.600) — cai no balde separado de
# "Search Queries", com teto de 100 buscas/dia. O videos.list que completa os
# dados custa 1 unidade.
#
# Falha aqui só avisa: sem panorama os metadados voltam a ser calibrados só
# pelo histórico do canal, que é como o pipeline funcionava até 2026-08-07.
# 1 liga, 0 desliga.
SEO_PANORAMA=1
# Vídeos do dia lidos por execução (teto da API: 50). Acima de ~20 o bloco vira
# ruído no prompt e o modelo começa a colar termo de outro assunto.
SEO_MAX_VIDEOS=20

