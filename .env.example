# ---- Chaves de API (obrigatórias) ----
# Chave da OpenAI (https://platform.openai.com/api-keys) — sumarização das
# trends, roteiro e descrição das mídias (visão)
OPENAI_API_KEY=

# Chave da ElevenLabs (https://elevenlabs.io/app/settings/api-keys) — narração
ELEVENLABS_API_KEY=

# Chave do Firecrawl (https://firecrawl.dev) — busca das notícias que
# enriquecem a trend escolhida (Search API com sources=["news"]).
FIRECRAWL_API_KEY=

# X API oficial (pay-per-use, ~US$ 0,005 por post lido). Consumer Key + Secret
# do app em https://developer.x.com — usados para coletar os posts das contas
# acompanhadas e baixar os clipes de vídeo dos posts originais da trend.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=

# ---- Fontes ----
# Opcional. A coleta usa a lista fixa CONTAS_PADRAO em pipeline/config.py
# (tecnologia, IA, mercado de trabalho e mercado financeiro). Se preenchido,
# usa somente estas contas (separadas por vírgula, sem @), ex.:
# OpenAI,AnthropicAI,unusual_whales
X_ACCOUNTS=

# Teto de posts lidos por execução (a X API cobra por post lido;
# 60 posts ≈ US$ 0,30)
X_MAX_POSTS=200
# Leituras extras de uma varredura `has:videos` sobre as MESMAS contas. A
# coleta acima ordena por relevância e NÃO prefere vídeo, então o post com
# clipe — o único material que o formato consegue usar — perdia vaga para
# texto. Nenhuma fonte nova entra por aqui. Vale 60 no --long-take e 0 no
# Short (que roda 12x por dia e não trava por falta de clipe); preencher aqui
# passa a valer para os dois. 0 desliga.
X_MAX_POSTS_VIDEO=60
# Busca ABERTA por clipes do assunto, fora das contas do canal. Só o
# --long-take usa: é ele que precisa de vários clipes do MESMO fato. As fontes
# aqui NÃO são curadas (conta desconhecida, telejornal reempacotado, material
# enganoso) e quem filtra é a auditoria de visão, que julga pertinência e não
# veracidade — por isso o orçamento é modesto. 0 desliga.
X_MAX_POSTS_BUSCA=30
# Leituras da TIMELINE das contas (/2/users/:id/tweets). A busca acima ordena
# por RELEVÂNCIA, e relevância no X é engajamento acumulado — o post publicado
# há vinte minutos (o vazamento, o comunicado, o número que acabou de sair)
# ainda não tem engajamento e por isso é justamente o que ela deixa de fora. A
# timeline é cronológica e não faz esse juízo. Custa UMA requisição por conta,
# então o orçamento é dividido em "posts por conta" e cobre um subconjunto
# rotativo das contas por execução (um cursor circular, .rotacao_timeline,
# garante que todas passem ao longo do dia). 0 desliga.
X_MAX_POSTS_TIMELINE=60

# Janela de coleta em horas (posts mais recentes que isso). Alargar NÃO custa
# mais na X API: o teto de leitura é o X_MAX_POSTS acima, e a janela só decide
# de que intervalo saem esses posts (a busca ordena por relevância).
# Case a janela com a CADÊNCIA do cron, não com o formato: um Short que roda de
# 4 em 4 horas quer 4, senão execuções seguidas pegam os mesmos posts. Já o
# --long-take roda 3x por semana e precisa de UM acontecimento com vários posts
# de vídeo nativo — com 4h ele quase nunca acha material para 8 clipes, então
# em produção os crons longos rodam com 48 (dois dias, que é o intervalo entre
# segunda, quarta e sexta).
JANELA_HORAS=24

# Quantas trends mais faladas do X coletar para escolher a do vídeo
NUM_TRENDS=10
# Quantas notícias (Firecrawl news) buscar para enriquecer a trend escolhida
NUM_NOTICIAS=6

# ---- Modelos (opcionais, valores padrão abaixo) ----
TEXT_MODEL=gpt-5.6-luna
# Geração das figuras sobrepostas (gráficos, tabelas, infográficos, cartazes)
IMAGEM_MODEL=gpt-image-2
# low | medium | high | auto. "medium" é o piso para figura com texto: em "low"
# o rótulo sai borrado, e rótulo borrado num gráfico não paga a chamada.
IMAGEM_QUALIDADE=medium

# ---- Narração (ElevenLabs) ----
ELEVENLABS_VOICE_ID=czvzJwIVS2asEKnthV40
# Voz usada quando rodar com -usa (público americano)
ELEVENLABS_VOICE_ID_USA=POPWFdpTM8Mn2ZQEagyQ
# eleven_v3 suporta audio tags ([excited], [whispers] etc.) no roteiro
ELEVENLABS_MODEL=eleven_v3

# ---- Vídeo ----
# Duração-alvo da narração em segundos; a duração final do vídeo segue o áudio
VIDEO_DURACAO=60
# Velocidade da narração — e, com ela, o ritmo do vídeo inteiro (cortes,
# legendas e sobreposições saem do alinhamento, que é reescalado junto).
# 1.0 = normal. O SHORT roda acelerado (ritmo é o que segura o feed); o formato
# longo roda em 1.0, porque análise em fala apressada não é acompanhável.
# O orçamento de palavras do roteiro é multiplicado por este valor: narração
# mais rápida cabe mais palavras no mesmo tempo de tela.
VIDEO_VELOCIDADE=1.25
# Resolução do vídeo. Padrão: vertical 9:16 para shorts/reels.
VIDEO_LARGURA=1080
VIDEO_ALTURA=1920

# ---- Material visual e auditoria ----
# Posts da trend consultados no lookup de mídias (≈ US$ 0,005 cada). Precisa
# ser folgado: a auditoria reprova material de telejornal e clipe fora do
# assunto, e sem pool a reprovação só teria como saída abortar o vídeo.
MAX_POSTS_MIDIA=12
# Clipes baixados ALÉM dos que entram na montagem, como folga da auditoria
POOL_EXTRA_CLIPES=3
# Fotos dos posts baixadas para as cartelas sobrepostas (0 desliga)
MAX_FOTOS=4
# Cartelas de imagem sobrepostas nos momentos-chave (0 desliga)
MAX_CARTELAS=2
# Figuras GERADAS pelo gpt-image-2 (gráfico, tabela, infográfico, diagrama ou
# cartaz) desenhadas a partir dos números que a narração diz, ancoradas na
# citação literal do trecho. Sobem de baixo do quadro e saem por cima. Cada
# figura é uma chamada paga de geração de imagem. 0 desliga.
MAX_FIGURAS=2

# ---- Formato longo (python main.py --long-take) ----
# Vídeo de análise em 16:9, de 90 a 120 segundos, sem legendas, para os dois
# canais (combina com -usa). Estas variáveis só valem nessa execução — as de
# cima continuam mandando no formato curto, então dá para ter os dois crons
# no Render com o mesmo .env.
# Duração-alvo da narração (obrigatoriamente entre 90 e 120)
LONG_DURACAO=105
LONG_LARGURA=1920
LONG_ALTURA=1080
# Clipes de vídeo do X usados na montagem (cada mídia lida ≈ US$ 0,005)
LONG_MAX_CLIPES=8
# Posts da trend consultados para achar esses clipes (≈ US$ 0,005 cada)
LONG_MAX_POSTS_MIDIA=16
# Notícias (Firecrawl news) que embasam a análise
LONG_NUM_NOTICIAS=10
# Cartelas de imagem sobrepostas e fotos baixadas para alimentá-las
LONG_MAX_CARTELAS=4
LONG_MAX_FOTOS=6
# Figuras geradas pelo gpt-image-2 (o dobro do Short: o dobro de tempo de tela)
LONG_MAX_FIGURAS=4
# Velocidade da narração no formato longo: NORMAL, por decisão editorial.
LONG_VELOCIDADE=1.0

# ---- YouTube (publicação automática via Data API v3) ----
# Credenciais OAuth (Google Cloud Console > Credentials > OAuth client ID,
# tipo "Desktop app"). A publicação roda sempre, independente da flag -usa.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Canal português — gerado uma vez com: python main.py --auth-youtube
YOUTUBE_REFRESH_TOKEN=
# Canal inglês (-usa) — gerado com: python main.py --auth-youtube-usa
YOUTUBE_REFRESH_TOKEN_USA=
# public | unlisted | private
YOUTUBE_PRIVACY=public
# Categoria do YouTube (28 = Science & Technology)
YOUTUBE_CATEGORY_ID=28
